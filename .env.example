# Flask Configuration
PORT=8080
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=skillswap-mvp-super-secret-key-change-in-production

# Custom Non-Obvious Admin URL Configuration
ADMIN_ROUTE_PREFIX=/control-center-8f7b2a9d

# Security, Cookie & Rate Limiting Configuration
SESSION_COOKIE_SECURE=False
SESSION_LIFETIME_HOURS=8
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# Database Configuration (Defaults to SQLite in instance/ directory)
DATABASE_URL=sqlite:///skillswap.db

# Platform Default Parameters
DEFAULT_FREE_TRIAL_CREDITS=50
DEFAULT_COMMISSION_PERCENT=20
CREDIT_TO_INR_RATE=10.0
CANCELLATION_WINDOW_HOURS=2

# Razorpay Test Credentials (Optional: Leave empty to use development payment simulator)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ENABLE_PAYMENT_SIMULATOR=True
